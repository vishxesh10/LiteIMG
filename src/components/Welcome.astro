  <footer class="relative mx-auto flex max-w-[1180px] flex-col gap-4 border-t border-[#dfe2e7] px-5 py-6 text-xs text-[#a4a9b3] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10"><span>Image Size Reducer</span><nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer navigation"><a href="/about" class="transition hover:text-[#155eef]">About us</a><a href="/contact" class="transition hover:text-[#155eef]">Contact us</a><a href="/privacy-policy" class="transition hover:text-[#155eef]">Privacy policy</a><a href="/terms" class="transition hover:text-[#155eef]">Terms &amp; conditions</a></nav></footer>
</main>

<script>
  // @ts-nocheck
  import { zipSync } from 'fflate';
  const $ = (selector) => document.querySelector(selector); const fileInput = $('#file-input'); const dropZone = $('#drop-zone'); const reduceButton = $('#reduce-button'); const uploadView = $('#upload-view'); const resultView = $('#result-view'); const fileList = $('#file-list'); const fileError = $('#file-error'); let selectedFiles = []; let targetBytes = 100000; let results = []; let originalUrls = [];
  const formatBytes = (bytes) => bytes < 1000000 ? `${Math.max(1, Math.round(bytes / 1000))} KB` : `${(bytes / 1000000).toFixed(2)} MB`; const validType = (file) => ['image/jpeg', 'image/png', 'image/webp'].includes(file.type);
  const setTarget = (bytes, button) => { targetBytes = bytes; document.querySelectorAll('.size-option').forEach((item) => item.className = 'size-option rounded-[7px] border border-[#dfe2e7] bg-white px-3 py-3 text-sm font-semibold text-[#404652] transition hover:border-[#155eef]'); if (button) button.className = 'size-option rounded-[7px] border border-[#155eef] bg-[#eef4ff] px-3 py-3 text-sm font-semibold text-[#155eef]'; };
  const showFiles = () => { fileList.innerHTML = selectedFiles.map((file) => `<div class="flex items-center justify-between rounded-[7px] border border-[#e8eaee] bg-white px-3 py-2 text-xs"><span class="max-w-[70%] truncate font-semibold">${file.name}</span><span class="text-[#69707d]">${formatBytes(file.size)}</span></div>`).join(''); fileList.classList.toggle('hidden', selectedFiles.length === 0); reduceButton.disabled = selectedFiles.length === 0; };
  const acceptFiles = (files) => { const incoming = [...files].filter((file) => validType(file) && file.size <= 25000000); if (!incoming.length) { fileError.textContent = 'Choose JPG, PNG, or WebP images under 25 MB each.'; fileError.classList.remove('hidden'); return; } selectedFiles = [...selectedFiles, ...incoming].slice(0, 20); fileError.classList.add('hidden'); dropZone.classList.add('border-[#36a269]', 'bg-[#f4fcf7]'); dropZone.querySelector('h2').textContent = `${selectedFiles.length} image${selectedFiles.length === 1 ? '' : 's'} selected`; showFiles(); };
  fileInput.addEventListener('change', (event) => acceptFiles(event.target.files)); dropZone.addEventListener('click', () => fileInput.click()); ['dragenter', 'dragover'].forEach((name) => dropZone.addEventListener(name, (event) => { event.preventDefault(); dropZone.classList.add('border-[#155eef]', 'bg-[#f8faff]'); })); ['dragleave', 'drop'].forEach((name) => dropZone.addEventListener(name, (event) => { event.preventDefault(); dropZone.classList.remove('border-[#155eef]', 'bg-[#f8faff]'); })); dropZone.addEventListener('drop', (event) => acceptFiles(event.dataTransfer.files)); document.querySelectorAll('.size-option').forEach((button) => button.addEventListener('click', () => setTarget(Number(button.dataset.size), button))); $('#custom-size').addEventListener('input', () => { if ($('#custom-size').value) { document.querySelectorAll('.size-option').forEach((item) => item.classList.remove('border-[#155eef]', 'bg-[#eef4ff]', 'text-[#155eef]')); targetBytes = Number($('#custom-size').value) * Number($('#custom-unit').value); } }); $('#custom-unit').addEventListener('change', () => { if ($('#custom-size').value) targetBytes = Number($('#custom-size').value) * Number($('#custom-unit').value); }); $('#quality').addEventListener('input', () => { $('#quality-value').textContent = `${$('#quality').value}%`; });
  const canvasBlob = (canvas, type, quality) => new Promise((resolve) => canvas.toBlob(resolve, type, quality));
  const loadImage = (file) => new Promise((resolve, reject) => { const image = new Image(); image.onload = () => resolve(image); image.onerror = reject; image.src = URL.createObjectURL(file); });
  const compressImage = async (file) => { const image = await loadImage(file); const maxWidth = Number($('#max-width').value); let width = image.naturalWidth; let height = image.naturalHeight; if (maxWidth && width > maxWidth) { height = Math.round(height * maxWidth / width); width = maxWidth; } const canvas = document.createElement('canvas'); canvas.width = width; canvas.height = height; const context = canvas.getContext('2d'); context.drawImage(image, 0, 0, width, height); const type = $('#output-format').value; const floor = Number($('#quality').value) / 100; let low = 0.04; let high = 1; let best; for (let attempt = 0; attempt < 10; attempt += 1) { const quality = (low + high) / 2; const candidate = await canvasBlob(canvas, type, quality); if (candidate.size <= targetBytes) { best = candidate; low = quality; } else high = quality; } if (!best) best = await canvasBlob(canvas, type, floor); return { blob: best, width, height, source: file }; };
  reduceButton.addEventListener('click', async () => { reduceButton.disabled = true; reduceButton.querySelector('span').textContent = 'Processing...'; results = []; try { for (const file of selectedFiles) results.push(await compressImage(file)); const outputType = $('#output-format').value; const extension = outputType === 'image/png' ? 'png' : outputType === 'image/webp' ? 'webp' : 'jpg'; $('#results').innerHTML = results.map((result, index) => { const originalUrl = URL.createObjectURL(result.source); originalUrls.push(originalUrl); const reducedUrl = URL.createObjectURL(result.blob); result.url = reducedUrl; return `<article class="grid gap-5 bg-[#f7f7f5] p-5 sm:grid-cols-[180px_1fr] sm:p-7"><div class="preview-frame"><img src="${reducedUrl}" alt="Reduced preview of ${result.source.name}" /></div><div class="flex flex-col justify-between gap-5"><div><p class="truncate text-sm font-bold">${result.source.name}</p><div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3 text-xs"><span class="text-[#69707d]">Before <strong class="ml-1 text-[#111318]">${formatBytes(result.source.size)}</strong></span><span class="text-[#69707d]">After <strong class="ml-1 text-[#155eef]">${formatBytes(result.blob.size)}</strong></span><span class="text-[#69707d]">Saved <strong class="ml-1 text-[#36a269]">${Math.max(0, Math.round((1 - result.blob.size / result.source.size) * 100))}%</strong></span><span class="text-[#69707d]">Size <strong class="ml-1 text-[#111318]">${result.width} x ${result.height}</strong></span></div></div><a href="${reducedUrl}" download="${result.source.name.replace(/\.[^/.]+$/, '')}-reduced.${extension}" class="w-fit rounded-[7px] border border-[#dfe2e7] bg-white px-3 py-2 text-xs font-bold text-[#404652] hover:border-[#155eef]">Download this image</a></div></article>`; }).join(''); $('#result-heading').textContent = `${results.length} image${results.length === 1 ? '' : 's'} ready.`; $('#download-label').textContent = results.length === 1 ? 'Download image' : 'Download all as ZIP'; uploadView.classList.add('hidden'); resultView.classList.remove('hidden'); resultView.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch { fileError.textContent = 'Something went wrong while reading an image. Please try another file.'; fileError.classList.remove('hidden'); } finally { reduceButton.disabled = false; reduceButton.querySelector('span').textContent = 'Reduce images'; } });
  $('#download-all').addEventListener('click', async () => { if (results.length === 1) { const link = document.createElement('a'); link.href = results[0].url; link.download = `${results[0].source.name.replace(/\.[^/.]+$/, '')}-reduced`; link.click(); return; } const files = {}; const extension = $('#output-format').value === 'image/png' ? 'png' : $('#output-format').value === 'image/webp' ? 'webp' : 'jpg'; for (const result of results) files[`${result.source.name.replace(/\.[^/.]+$/, '')}-reduced.${extension}`] = new Uint8Array(await result.blob.arrayBuffer()); const archive = zipSync(files); const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([archive], { type: 'application/zip' })); link.download = 'reduced-images.zip'; link.click(); });
  $('#start-over').addEventListener('click', () => { originalUrls.forEach((url) => URL.revokeObjectURL(url)); results.forEach((result) => URL.revokeObjectURL(result.url)); selectedFiles = []; results = []; fileInput.value = ''; fileList.innerHTML = ''; fileList.classList.add('hidden'); reduceButton.disabled = true; dropZone.querySelector('h2').textContent = 'Drop images here'; dropZone.classList.remove('border-[#36a269]', 'bg-[#f4fcf7]'); resultView.classList.add('hidden'); uploadView.classList.remove('hidden'); });
  const themeToggle = $('#theme-toggle'); const themeIcon = $('#theme-icon'); const setTheme = (isDark) => { document.documentElement.classList.toggle('dark-mode', isDark); themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode'); themeToggle.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode'); themeIcon.innerHTML = isDark ? '<path d="M15.5 12.5A5.5 5.5 0 0 1 7.5 4a5.5 5.5 0 1 0 8 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />' : '<path d="M10 3v2m0 10v2M3 10h2m10 0h2M5.05 5.05l1.42 1.42m7.06 7.06 1.42 1.42M14.95 5.05l-1.42 1.42m-7.06 7.06-1.42 1.42M10 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />'; }; setTheme(localStorage.getItem('image-reducer-theme') === 'dark'); themeToggle.addEventListener('click', () => { const isDark = !document.documentElement.classList.contains('dark-mode'); setTheme(isDark); localStorage.setItem('image-reducer-theme', isDark ? 'dark' : 'light'); });
</script>
