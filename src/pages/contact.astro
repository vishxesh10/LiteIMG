---
import InfoPage from '../components/InfoPage.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Image Size Reducer" description="Contact the Image Size Reducer team with questions, feedback, or feature suggestions.">
  <InfoPage eyebrow="Get in touch" title="Contact us." intro="Have a question, found a problem, or have an idea that would make Image Size Reducer better? We would like to hear from you.">
    <h2>How to reach us</h2>
    <p>Email us at <a class="font-semibold text-[#155eef] hover:underline" href="mailto:vishesh23022005@gmail.com">vishesh23022005@gmail.com</a>. Include the page you were using, your browser, and a short description of the issue so we can help quickly.</p>
    <h2>Feature suggestions</h2>
    <p>We are focused on making image size limits easier to meet. Suggestions for useful formats, accessibility improvements, or faster workflows are always welcome.</p>
    <h2>Privacy note</h2>
    <p>Please do not email private images or sensitive files. Image Size Reducer processes files locally, and our support inbox does not need your original image to investigate most questions.</p>
  </InfoPage>
</Layout>
